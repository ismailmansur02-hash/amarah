# ============================================================================
# Copy this file to `.env` and fill in the real values from your dashboards.
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and is SAFE to ship
# (anon key + RevenueCat public keys are designed to be client-side).
#
# NEVER put the Supabase SERVICE ROLE key here or anywhere in the app. It lives
# only as a Supabase edge-function secret (set automatically for deployed
# functions; nothing to configure manually).
# ============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- RevenueCat (Project → API keys → Public app-specific keys) -------------
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
