{
  "expo": {
    "name": "Prep a Constable",
    "slug": "prep-a-constable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prepaconstable",
    "primaryColor": "#1A3A6C",
    "splash": {
      "backgroundColor": "#FAFAF7",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Prep a Constable uses the microphone so you can practise delivering the caution and stop-search wording out loud.",
          "speechRecognitionPermission": "Prep a Constable converts what you say into text so your verbal drill can be marked word-for-word. Nothing is recorded or uploaded.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "uk.co.prepaconstable.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "uk.co.prepaconstable.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A3A6C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
